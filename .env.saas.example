# Shared/SaaS deployment additions. Start from .env.example, set this mode, and
# use a managed secret store rather than committing credentials.
LORE_DEPLOYMENT_MODE=saas
NODE_ENV=production
DEMO_MODE=false

# Browser identity
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=https://lore.example.com/api/auth/github/callback

# Repository installations, webhooks, and background history access
GITHUB_AUTH_MODE=app
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# SaaS infrastructure and public origins
APP_URL=https://lore.example.com
WEB_ORIGIN=https://lore.example.com
TRUST_PROXY=true
DATABASE_URL=
REDIS_URL=
SESSION_SECRET=
ENCRYPTION_KEY=
