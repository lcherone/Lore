# Local users: run `npm run local`. It creates and maintains this file for you.
# You supply only GITHUB_TOKEN and, for real AI extraction, OPENAI_API_KEY.
# Everything else below is a safe local default or is generated automatically.

# Runtime. Local installs run the full persistent product by default.
# `npm run demo` explicitly selects development-only in-memory fixtures without
# changing this file.
NODE_ENV=production
LORE_DEPLOYMENT_MODE=local
API_PORT=3001
API_HOST=127.0.0.1
APP_URL=http://localhost:5173
WEB_ORIGIN=http://localhost:5173
TRUST_PROXY=false
LOG_LEVEL=info

# Persistence and jobs
DATABASE_URL=postgresql://lore:lore@localhost:5432/lore?schema=public
REDIS_URL=redis://localhost:6379
WORKER_CONCURRENCY=4
WORKER_MAX_STALLED_COUNT=10

# Local session protection. `npm run local:setup` generates this automatically.
SESSION_SECRET=replace-with-at-least-32-random-characters
AUTH_SESSION_TTL_HOURS=24

# Required only when the service itself is explicitly authorised to read checkouts.
# Prefer `lore index` graph upload; separate multiple roots with your platform path delimiter.
LORE_ALLOWED_REPOSITORY_ROOTS=

# Full local GitHub integration. This one token provides the local profile,
# repository picker, and read-only PR/review/history ingestion. No OAuth App,
# callback, GitHub App, PEM, installation ID, or local user/org IDs are needed.
GITHUB_TOKEN=

# Optional crawler safety ceiling. Lore defaults to 1,000 requests/hour (one
# request every 3.6 seconds), serialises worker requests, and slows further from
# GitHub's rate-limit headers. Increase only when you intentionally accept the
# additional shared PAT/App quota use.
GITHUB_REQUESTS_PER_HOUR=1000

# AI extraction is opt-in and schema validated. Deterministic indexing, policy,
# and verification remain authoritative. `local:setup` selects OpenAI when a key exists.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
