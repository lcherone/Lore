# Runtime
NODE_ENV=development
DEMO_MODE=true
# Show the real login screen in demo mode. `npm run demo` enables this automatically.
DEMO_REQUIRE_LOGIN=false
API_PORT=3001
API_HOST=127.0.0.1
APP_URL=http://localhost:5173
WEB_ORIGIN=http://localhost:5173
TRUST_PROXY=false
LOG_LEVEL=info

# Persistence and jobs
DATABASE_URL=postgresql://lore:lore@localhost:5432/lore?schema=public
REDIS_URL=redis://localhost:6379
WORKER_CONCURRENCY=4

# Auth and encryption (replace for any shared environment)
SESSION_SECRET=replace-with-at-least-32-random-characters
AUTH_SESSION_TTL_HOURS=24
# Reserved for a future production secret-encryption boundary; not consumed by this prototype.
ENCRYPTION_KEY=replace-with-a-32-byte-base64-key
LOCAL_DEV_AUTH=false
LOCAL_ORGANISATION_ID=
LOCAL_USER_ID=
LOCAL_USER_NAME=

# GitHub sign-in (identity only)
# Create a GitHub OAuth App with homepage http://localhost:5173 and callback:
# http://localhost:5173/api/auth/github/callback
# These credentials identify people. They do not grant Lore access to repositories.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:5173/api/auth/github/callback

# Required only when the service itself is explicitly authorised to read checkouts.
# Prefer `lore index` graph upload; separate multiple roots with your platform path delimiter.
LORE_ALLOWED_REPOSITORY_ROOTS=

# GitHub repository integration (separate from sign-in; optional in demo mode).
# Use a PAT for local history imports; use a GitHub App for webhooks/shared deployments.
# Leave blank to infer from credentials, or set disabled, token, or app explicitly.
GITHUB_AUTH_MODE=
# Local PAT mode. Prefer a chmod 600 file so the token is not copied into shell history.
GITHUB_TOKEN=
GITHUB_TOKEN_PATH=
# Docker token overlay: host path mounted by docker-compose.github-token.yml.
GITHUB_TOKEN_FILE=
# Optional target for `npm run github:check` and the local-production preflight.
LORE_TEST_REPOSITORY=
# Set false only when intentionally starting without a live GitHub reachability check.
LORE_GITHUB_PREFLIGHT=true

# GitHub App mode
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# Native development: prefer a chmod 600 PEM file outside the repository.
GITHUB_PRIVATE_KEY_PATH=
# Docker overlay: host path mounted by docker-compose.github.yml.
GITHUB_PRIVATE_KEY_FILE=
# Alternative for secret managers/CI: an inline PEM with literal \n separators.
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# AI is optional. Core indexing, context, policy, and verification remain deterministic.
# OPENAI_* are reserved until a real opt-in provider adapter is implemented.
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=
