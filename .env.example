# Runtime
NODE_ENV=development
DEMO_MODE=true
API_PORT=3001
APP_URL=http://localhost:5173
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Persistence and jobs
DATABASE_URL=postgresql://lore:lore@localhost:5432/lore?schema=public
REDIS_URL=redis://localhost:6379

# Auth and encryption (replace for any shared environment)
SESSION_SECRET=replace-with-at-least-32-random-characters
ENCRYPTION_KEY=replace-with-a-32-byte-base64-key
LOCAL_DEV_AUTH=false
LOCAL_ORGANISATION_ID=
LOCAL_USER_ID=
LOCAL_USER_NAME=

# GitHub App (optional in demo mode)
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# AI is optional. Core indexing, context, policy, and verification remain deterministic.
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=
