{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "useUnknownInCatchVariables": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@lore/core/*": ["packages/core/src/*"],
      "@lore/shared/*": ["packages/shared/src/*"],
      "@lore/database/*": ["packages/database/src/*"],
      "@lore/git/*": ["packages/git/src/*"],
      "@lore/analysis/*": ["packages/analysis/src/*"],
      "@lore/knowledge/*": ["packages/knowledge/src/*"],
      "@lore/impact/*": ["packages/impact/src/*"],
      "@lore/policy/*": ["packages/policy/src/*"],
      "@lore/context/*": ["packages/context/src/*"],
      "@lore/reporting/*": ["packages/reporting/src/*"],
      "@lore/github/*": ["packages/github/src/*"],
      "@lore/ai/*": ["packages/ai/src/*"]
    }
  },
  "include": ["apps/**/*.ts", "apps/**/*.tsx", "packages/**/*.ts", "prisma/**/*.ts", "prisma.config.ts", "scripts/**/*.ts", "tests/**/*.ts", "tsup.config.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "dist", "apps/web/dist"]
}
